# ─────────────────────────────────────────────────────────────────────────────
# Site Visit AI Assistant — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Site Visit AI Assistant"
APP_ENV=development
APP_DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=sitevisit
POSTGRES_PASSWORD=sitevisit_secret
POSTGRES_DB=sitevisit_db
DATABASE_URL=postgresql+asyncpg://sitevisit:sitevisit_secret@postgres:5432/sitevisit_db
DATABASE_URL_SYNC=postgresql://sitevisit:sitevisit_secret@postgres:5432/sitevisit_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@redis:6379/2

# ── AI — Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_OPUS_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=4096

# ── AI — OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GPT4_MODEL=gpt-4.1
GPT4_MAX_TOKENS=4096

# ── Tavily Search ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── Storage (lưu local trên Mac Mini) ─────────────────────────────────────────
TMP_UPLOAD_DIR=/tmp/sitevisit
MEDIA_DIR=/data/sitevisit/photos
MEDIA_URL_PREFIX=/media
MAX_FILE_SIZE_MB=20
PROCESSED_MAX_SIZE_MB=5

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_TASK_TIMEOUT=300
CELERY_MAX_RETRIES=3

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://your-domain.com
